{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex.a-portal.net/schemas/research-entry.schema.json",
  "title": "Vertex Research Entry",
  "type": "object",
  "required": ["paper_id", "title", "version", "status", "paper_type", "canonical_url", "source_verified"],
  "properties": {
    "paper_id": {"type": "string"},
    "title": {"type": "string"},
    "subtitle": {"type": ["string", "null"]},
    "authors": {"type": "array", "items": {"type": "string"}},
    "organization": {"type": ["string", "null"]},
    "version": {"type": "string"},
    "status": {"enum": ["concept", "draft", "technical_note", "technical_paper", "experimental", "published", "superseded", "definition_pending"]},
    "paper_type": {"type": "string"},
    "review_status": {"type": "string"},
    "created_at": {"type": ["string", "null"], "format": "date"},
    "published_at": {"type": ["string", "null"], "format": "date"},
    "updated_at": {"type": ["string", "null"], "format": "date"},
    "canonical_url": {"type": "string", "format": "uri"},
    "abstract": {"type": ["string", "null"]},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "related_concepts": {"type": "array", "items": {"type": "string"}},
    "related_products": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "references": {"type": "array"},
    "external_references": {"type": "array"},
    "source_path": {"type": "string"},
    "source_verified": {"type": "boolean"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "provenance", "evidence", "confidence", "status"],
        "properties": {
          "claim": {"type": "string"},
          "provenance": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]},
          "confidence": {"type": ["string", "number", "null"]},
          "status": {"enum": ["established", "supported", "experimental", "hypothesis", "observation", "unknown"]}
        }
      }
    },
    "revision_history": {"type": "array"}
  }
}
