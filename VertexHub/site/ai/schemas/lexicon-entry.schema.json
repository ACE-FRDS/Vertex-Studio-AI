{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex.a-portal.net/schemas/lexicon-entry.schema.json",
  "title": "Vertex Lexicon Entry",
  "type": "object",
  "required": ["id", "name", "status"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "abbreviation": {"type": ["string", "null"]},
    "expandedName": {"type": ["string", "null"]},
    "definition": {"type": ["string", "null"]},
    "status": {"enum": ["official", "adopted", "provisional", "historical", "deprecated", "rejected", "definition_pending", "research"]},
    "first_known_date": {"type": ["string", "null"], "format": "date"},
    "category": {"type": ["string", "null"]},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "previous_names": {"type": "array", "items": {"type": "string"}},
    "related_concepts": {"type": "array", "items": {"type": "string"}},
    "defined_in": {"type": "array", "items": {"type": "string"}},
    "implemented_in": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"], "format": "date"},
    "source_verified": {"type": "boolean"},
    "public": {"type": "boolean"}
  }
}
